# Sunucuda: APP_ENV=production, APP_DEBUG=false, APP_URL=https://... (docs/YAPILACAKLAR.md, Aşama 10)
APP_NAME="B2B Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Günlük dosyası her gün ayrı tutulur, son LOG_DAILY_DAYS gün saklanır (tek dosya sınırsız büyümez).
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=b2b
DB_USERNAME=b2b
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Üretimde (APP_ENV=production) oturum çerezi kendiliğinden yalnızca HTTPS ile gönderilir.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# İşletme Gmail uygulama şifrelerini şifreleyen ayrı anahtar (APP_KEY'den bağımsız)
MAIL_SECRET_KEY=

# Platform yöneticisi paneli için isteğe bağlı IP izin listesi (virgülle)
PLATFORM_ALLOWED_IPS=

# Mağaza (docs/13-magaza-mimarisi.md)
STORE_DOMAIN=magaza.localhost
STORE_ADMIN_DOMAIN=yonetim.localhost

# Mağaza adı (e-postalar, vitrin) ve form bot koruması (yalnızca testlerde kapatılır)
STORE_NAME="Yapboz Kırtasiye"
STORE_BOT_PROTECTION=true

# B2B marka adı ve kısa tanıtımı (giriş sayfaları, e-postalar)
BRAND_NAME="Yapboz Kırtasiye B2B"
BRAND_TAGLINE="Kırtasiye toptan sipariş platformu"

# Sistem e-postası: platform ve mağaza e-postaları (parola sıfırlama, sipariş, iade, yönetici bildirimleri).
# Boşsa yerelde içerik günlüğe yazılır; üretimde e-posta gönderilmez. Mağaza trafiği için işlem e-postası servisi önerilir.
SYSTEM_MAIL_HOST=
SYSTEM_MAIL_PORT=587
SYSTEM_MAIL_USERNAME=
SYSTEM_MAIL_PASSWORD=
SYSTEM_MAIL_FROM_ADDRESS=
SYSTEM_MAIL_FROM_NAME="Yapboz Kırtasiye"

# Yedekleme (Platform → Yedekler; her gece 03:30). Sunucuda mysqldump PATH'teyse boş bırakılır;
# Windows'ta tam yol verilir, ör. "C:/tools/mysql84/bin/mysqldump.exe"
BACKUP_MYSQLDUMP=mysqldump
BACKUP_KEEP=14
